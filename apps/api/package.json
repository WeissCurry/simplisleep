{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm \"--external:node:*\" --outfile=../../deploy/api/index.mjs \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/seed.ts",
    "test": "vitest run",
    "lint": "echo 'No lint in api yet'"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "google-auth-library": "^11.3.4",
    "hono": "^4.7.2",
    "shared": "workspace:*",
    "viem": "^2.58.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "esbuild": "0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
