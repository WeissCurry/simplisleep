# Environment runtime: Wajib di production ('production' / 'development'). Mengaktifkan pengamanan ketat secret dan mematikan auth demo.
NODE_ENV=development

# Port listening server API backend: Opsional (default: 3100), disediakan platform PaaS hosting atau diset manual.
PORT=3100

# Path database SQLite: Opsional (rekomendasi production), arahkan ke volume disk persisten hosting (default: ./simplisleep.db).
DB_PATH=./simplisleep.db

# Kunci penandatanganan token JWT: Wajib di production (HS256). Buat acak dengan: openssl rand -hex 32
JWT_SECRET=

# Kunci enkripsi AES-256-GCM custodial wallet: Wajib di production. Buat acak: openssl rand -hex 32 (simpan permanen agar wallet tidak terkunci).
WALLET_ENC_KEY=

# OAuth 2.0 Client ID Google Sign-In: Wajib untuk Google auth. Dapatkan dari Google Cloud Console > APIs & Services > Credentials (isi sama di web environment.ts).
GOOGLE_CLIENT_ID=

# Domain web frontend yang diizinkan CORS: Wajib di production jika API beda domain. Boleh daftar domain dipisah koma (contoh: https://simplisleeps.netlify.app,http://localhost:4200).
WEB_ORIGIN=http://localhost:4200

# Percayai header proxy (X-Forwarded-For): Opsional ('true'/'false'). Wajib diset 'true' bila server berada di balik reverse proxy PaaS (Railway/Fly/Cloudflare/Nginx) agar IP rate limiting akurat.
TRUST_PROXY=false

# Flag auto-seeding data awal saat tabel users kosong: Opsional ('true'/'false'). Di production default mati, set 'true' jika ingin database baru otomatis diisi data demo Simplimates.
AUTO_SEED=

# Token otentikasi endpoint admin POST /api/admin/close-week: Wajib di production. Buat acak dengan: openssl rand -hex 24
ADMIN_TOKEN=

# Flag aktivasi login 3 akun demo tanpa password: Opsional ('true'/'false'). Wajib diset 'false' di production.
ENABLE_DEMO_LOGIN=true

# RPC URL Ethereum Sepolia: Opsional (Alchemy/Infura/QuickNode). Bila kosong, transaksi on-chain otomatis degrade ke status pending-mint.
SEPOLIA_RPC_URL=

# Private key wallet relayer gas Sepolia: Opsional (format 0x...). Ekspor dari wallet testnet terdedikasi dan danai via Sepolia Faucet.
DEPLOYER_PRIVATE_KEY=

# Alamat kontrak SleepCards.sol (ERC-5192 Soulbound) di Sepolia: Opsional, diperoleh setelah menjalankan script deploy kontrak.
SLEEP_CARDS_ADDRESS=

# Alamat kontrak LeaderboardCommit.sol di Sepolia: Opsional, diperoleh setelah menjalankan script deploy kontrak.
LEADERBOARD_COMMIT_ADDRESS=

# API Key Etherscan: Opsional (build/deploy), digunakan untuk verifikasi source code smart contract di Etherscan Sepolia.
ETHERSCAN_API_KEY=

# Base URI metadata gambar NFT IPFS: Opsional (build), digunakan oleh script build-metadata.ts (default: ipfs://TODO/).
CARD_IMAGE_BASE_URL=ipfs://TODO/

# Alamat wallet MetaMask/Web3 penerima kartu minting 3 akun demo: Opsional. Bila diisi alamat valid (0x...), semua mint kartu dari 3 akun demo dialihkan ke wallet ini agar bisa dipantau langsung di MetaMask/Etherscan Sepolia.
DEMO_WALLET_ADDRESS=
